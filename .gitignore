# Ignore rhino file
KiwiMS_App/.rhino

# Ignore aider
.aider*

# Ignore claude
.claude/

# Ignore testing R scripts
*testing.R

# Ignore R ecosystem
KiwiMS_App/R-Portable/
KiwiMS_App/R-Portable.zip
KiwiMS_App/renv/library/
KiwiMS_App/renv.zip

# Ignore conda environment
KiwiMS_App/env_kiwims/
KiwiMS_App/env_kiwims.zip

# Ignore the compiled launcher (built by dev/build-launcher.ps1)
KiwiMS_App/KiwiMS.exe

# Ignore the installer output
KiwiMS-Windows-x86_64.exe
Output/

# Ignore the VC++ redistributable (fetched at build time by dev/build-installer.ps1)
setup/VC_redist.x64.exe

# Edge-case kit: generated on request by tests/edge_cases/generate_all.R
# (the test files) and tests/edge_cases/fixture/make_fixture.R (the database)
KiwiMS_App/tests/edge_cases/*/*.csv
KiwiMS_App/tests/edge_cases/fixture/*.db
