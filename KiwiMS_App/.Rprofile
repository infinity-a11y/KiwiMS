source("renv/activate.R")

# Dev helpers (startShiny()) for an interactive session that starts here, as
# Positron does when it restarts R in the folder startShiny() changed into.
# dev/ is not shipped, so an installed KiwiMS never sources it.
if (interactive() && file.exists("dev/dev_mode.R")) {
  source("dev/dev_mode.R")
}
